# Copy these into Streamlit Community Cloud -> your app -> Settings -> Secrets.
# Never commit real values to GitHub.

# Online PostgreSQL database (e.g. from neon.tech). Without it the app uses a local SQLite file.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Your own sign-in email: gives you the Platform page listing every institution (counts only).
PLATFORM_ADMIN_EMAIL = "you@drspecimen.online"

# Optional: sign users out after this many idle minutes.
IDLE_TIMEOUT_MINUTES = "30"

# Optional: real email delivery for student messages.
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "you@gmail.com"
# SMTP_PASSWORD = "app-password"
# SMTP_FROM = "Learning Analytics <you@gmail.com>"
